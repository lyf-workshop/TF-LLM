# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
/.venv/

# Test, lint, and tool caches
/.cache/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/

# Local databases and logs
*.db
*.db-wal
*.db-shm
*.log
/logs/

# Local runtime output
/tmp/
/data/
/site/
/workspace/mistake_bank/
/workspace/quality_tracking/
/workspace/results/
/workspace/local/
/workspace/skillsbench_harbor_compat/
/workspace/skillsbench_runs/
/workspace/temp/

# External benchmark checkouts and generated benchmark results
/SkillsBench-repo/
/KORGym/results/
/KORGym/game_lib/*/result/

# Generated configs
/configs/tools/generated/
/configs/agents/generated/

# Large generated artifact types
*.jsonl
*.csv
*.xlsx
*.xls
*.pdf
*.mp3
*.mp4
*.wav
*.MOV
*.xml
*.jpg
*.zip
*.docx
*.pptx
*.m4a
*.pdb
*.bak
*.publish
*.html
*.pkl
*.whl

# Configuration protocols and small test fixtures are source artifacts even
# when they use formats that are large runtime outputs elsewhere.
!/configs/**/*.jsonl
!/configs/**/*.csv
!/configs/**/*.tsv
!/tests/**/*.jsonl
!/tests/**/*.csv
!/tests/**/*.tsv

# Secrets and local environment overrides
.env
.env.*
!.env.example
!docker/.env.docker.example

# IDEs and editors
.idea/
.vscode/
.gemini/
.claude/
.codex/

# OS files
.DS_Store

# Local-only project files
.NOTES
test.yaml
pgs
CLAUDE.md
.mcp.json
.specify/
alembic.ini
alembic/
# Generated agent configs (can be regenerated from training)
/configs/agents/practice/*_agent.yaml

# Local smoke-run configs (canonical templates and measured configs stay tracked)
/configs/practice/**/*smoke*.yaml

# Temporary repository-root test scripts. Never ignore the real tests/ tree.
/test_*.py

# Workspace (experiment results, not for version control). Keep only the
# directory contract itself trackable.
/workspace/*
!/workspace/.gitkeep
!/workspace/README.md

# Temporary and backup files
*~
*.swp
*.swo
*.bak
*.backup
/backup/
